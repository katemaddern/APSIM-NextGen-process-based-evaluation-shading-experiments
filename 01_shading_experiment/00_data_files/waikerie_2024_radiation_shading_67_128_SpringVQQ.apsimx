            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Soils.Nutrients;",
                "using APSIM.Shared.Utilities;",
                "using Models.Surface;",
                "using Models.Utilities;",
                "using Models.Soils.Nutrients;",
                "using Models.Soils;",
                "using Models.PMF;",
                "using Models.Core;",
                "using System;",
                "using System.Linq;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock Clock;",
                "        [Link] private Plant Wheat;",
                "        [Link] private ISoilWater SoilWater;",
                "        [Link] private Nutrient nutrient;",
                "        [Link] private SurfaceOrganicMatter SOM;",
                "        [Link] private Summary Summary;",
                "        ",
                "        [Description(\"Reset Water daily?\")]",
                "        public bool ResetWater {get;set;} = true;",
                "        ",
                "        [Description(\"Reset Soil Nutrients daily?\")]",
                "        public bool ResetNutrients {get;set;} = true;",
                "        ",
                "        [Description(\"Reset Surface Organic Matter daily?\")]",
                "        public bool ResetSOM {get;set;} = true;",
                "        ",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            // This will run every day",
                "            if (ResetWater)",
                "            {",
                "                Summary.WriteMessage(this, $\"Reset Water on {Clock.Today:dd-MMM}\", MessageType.Diagnostic);",
                "                SoilWater.Reset();",
                "            }",
                "            ",
                "            if (ResetNutrients)",
                "            {",
                "                Summary.WriteMessage(this, $\"Reset Nitrogen on {Clock.Today:dd-MMM}\", MessageType.Diagnostic);",
                "                nutrient.Reset();",
                "            }",
                "            ",
                "            if (ResetSOM)",
                "            {",
                "                Summary.WriteMessage(this, $\"Reset Surface OM on {Clock.Today:dd-MMM}\", MessageType.Diagnostic);",
                "                SOM.Reset();",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "ResetWater",
                  "Value": "True"
                },
                {
                  "Key": "ResetNutrients",
                  "Value": "True"
                },
                {
                  "Key": "ResetSOM",
                  "Value": "True"
                }
